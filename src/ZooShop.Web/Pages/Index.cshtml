@page
@model ZooShop.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Вход";
}

<div style="max-width: 380px; margin: 60px auto; background: #1e1e1e; padding: 28px; border-radius: 10px; border: 1px solid #333;">
    <h2 style="text-align: center; margin-top: 0; margin-bottom: 20px;">Магазин зоотоваров</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="background: #5a1d1d; color: #ff9999; padding: 10px; border-radius: 6px; margin-bottom: 15px; text-align: center;">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" asp-page-handler="Login">
        <div style="margin-bottom: 14px;">
            <label style="display: block; margin-bottom: 6px; color: #bbb;">Логин</label>
            <input type="text" name="Login" value="@Model.Login" required
                   style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #444; background: #2b2b2b; color: #fff;" />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 6px; color: #bbb;">Пароль</label>
            <input type="password" name="Password" required
                   style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #444; background: #2b2b2b; color: #fff;" />
        </div>

        <button type="submit" class="accent-btn" style="width: 100%; padding: 11px; font-size: 16px;">
            Войти
        </button>
    </form>
</div>
