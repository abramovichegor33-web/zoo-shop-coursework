@page
@model ZooShop.Web.Pages.CartModel
@{
    ViewData["Title"] = "Корзина и оплата";
}

<h2>Корзина</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div style="background: #5a1d1d; color: #ff9999; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px;">
        @Model.Error
    </div>
}

@if (Model.Items.Count == 0)
{
    <div style="background: #1e1e1e; padding: 24px; border-radius: 8px; text-align: center;">
        <p style="color: #aaa; margin-bottom: 16px;">Ваша корзина пока пуста.</p>
        <a href="/Products" class="accent-btn">Перейти к покупкам</a>
    </div>
}
else
{
    <table style="margin-bottom: 24px;">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Цена</th>
                <th>Количество</th>
                <th>Сумма</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.Price.ToString("0.00") ₽</td>
                    <td>@item.Quantity шт.</td>
                    <td>@item.Sum.ToString("0.00") ₽</td>
                    <td>
                        <div style="display: flex; gap: 6px;">
                            <form method="post" asp-page-handler="Minus" style="margin: 0;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="nav-btn" style="padding: 5px 10px;">-1</button>
                            </form>
                            <form method="post" asp-page-handler="Plus" style="margin: 0;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="nav-btn" style="padding: 5px 10px;">+1</button>
                            </form>
                            <form method="post" asp-page-handler="Remove" style="margin: 0;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="danger-btn" style="padding: 5px 10px;">Убрать</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div style="background: #1e1e1e; padding: 20px; border-radius: 8px; max-width: 500px; border: 1px solid #333;">
        <h3 style="margin-top: 0;">Итого к оплате: @Model.Total.ToString("0.00") ₽</h3>

        <form method="post" asp-page-handler="Checkout" onsubmit="showProcessing()">
            <div style="margin-bottom: 14px;">
                <label style="display: block; margin-bottom: 6px; color: #bbb;">Способ оплаты:</label>
                <select name="paymentMethod" id="paymentMethod" onchange="toggleCardFields()" style="width: 100%;">
                    <option value="Банковская карта">Банковская карта</option>
                    <option value="СБП">СБП (Система быстрых платежей)</option>
                    <option value="При получении">При получении</option>
                </select>
            </div>

            <div id="cardFields" style="margin-bottom: 16px; background: #262626; padding: 14px; border-radius: 6px;">
                <div style="margin-bottom: 10px;">
                    <label style="display: block; margin-bottom: 4px; font-size: 13px; color: #bbb;">Номер карты (16 цифр)</label>
                    <input type="text" name="cardNumber" placeholder="0000 0000 0000 0000" maxlength="19" style="width: 100%;" />
                </div>
                <div style="display: flex; gap: 10px;">
                    <div style="flex: 1;">
                        <label style="display: block; margin-bottom: 4px; font-size: 13px; color: #bbb;">Срок (ММ/ГГ)</label>
                        <input type="text" name="cardExpiry" placeholder="12/27" maxlength="5" style="width: 100%;" />
                    </div>
                    <div style="flex: 1;">
                        <label style="display: block; margin-bottom: 4px; font-size: 13px; color: #bbb;">CVV (3 цифры)</label>
                        <input type="password" name="cardCvv" placeholder="123" maxlength="3" style="width: 100%;" />
                    </div>
                </div>
            </div>

            <button type="submit" id="payBtn" class="accent-btn" style="width: 100%; padding: 11px; font-size: 16px;">
                Оплатить и оформить заказ
            </button>
            <div id="processingMsg" style="display: none; text-align: center; margin-top: 12px; color: #ffd54f;">
                ⏳ Обработка платежа (подождите 2 секунды)...
            </div>
        </form>
    </div>

    <script>
        function toggleCardFields() {
            var method = document.getElementById('paymentMethod').value;
            var block = document.getElementById('cardFields');
            block.style.display = (method === 'Банковская карта') ? 'block' : 'none';
        }
        function showProcessing() {
            document.getElementById('payBtn').disabled = true;
            document.getElementById('processingMsg').style.display = 'block';
        }
    </script>
}
