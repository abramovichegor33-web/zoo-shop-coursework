@using ZooShop.Web
@{
    var user = WebSession.GetUser(Context);
    var themeColor = WebSession.GetThemeColor(Context);
    var cart = WebSession.GetCart(Context);
    var cartCount = 0;
    foreach (var item in cart) { cartCount += item.Quantity; }
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Магазин зоотоваров</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #121212;
            color: #e0e0e0;
        }
        header {
            background-color: @themeColor;
            color: #ffffff;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        }
        .brand {
            font-size: 20px;
            font-weight: bold;
            color: #fff;
            text-decoration: none;
        }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .nav-btn {
            background: rgba(0, 0, 0, 0.25);
            color: #fff;
            text-decoration: none;
            padding: 7px 13px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            font-size: 14px;
            cursor: pointer;
        }
        .nav-btn:hover {
            background: rgba(0, 0, 0, 0.4);
        }
        .accent-btn {
            background-color: @themeColor;
            color: #ffffff;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }
        .accent-btn:hover {
            filter: brightness(1.1);
        }
        .danger-btn {
            background-color: #b71c1c;
            color: #ffffff;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
        }
        .container {
            max-width: 1150px;
            margin: 24px auto;
            padding: 0 16px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #1e1e1e;
            border-radius: 8px;
            overflow: hidden;
        }
        th, td {
            padding: 10px 12px;
            border-bottom: 1px solid #2e2e2e;
            text-align: left;
        }
        th {
            background: #272727;
            color: #fff;
        }
        input, select {
            background: #2b2b2b;
            color: #fff;
            border: 1px solid #444;
            padding: 8px 10px;
            border-radius: 6px;
        }
    </style>
</head>
<body>
    <header>
        <div style="display: flex; align-items: center; gap: 16px;">
            <a class="brand" href="/Products">🐾 Магазин зоотоваров</a>
            @if (user != null)
            {
                <span style="font-size: 14px; opacity: 0.9;">
                    @user.FullName (@(user.IsAdmin ? "Администратор" : "Покупатель"))
                </span>
            }
        </div>

        <div class="nav-links">
            <form method="post" asp-page="/Index" asp-page-handler="Color" style="margin: 0;">
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <select name="hex" onchange="this.form.submit()" class="nav-btn" style="background: rgba(0,0,0,0.35); color: #fff;">
                    @foreach (var kv in WebSession.Colors)
                    {
                        if (kv.Value == themeColor)
                        {
                            <option value="@kv.Value" selected style="background: #222; color: #fff;">Цвет: @kv.Key</option>
                        }
                        else
                        {
                            <option value="@kv.Value" style="background: #222; color: #fff;">Цвет: @kv.Key</option>
                        }
                    }
                </select>
            </form>

            @if (user != null)
            {
                <a class="nav-btn" href="/Products">Товары</a>
                <a class="nav-btn" href="/Cart">Корзина (@cartCount)</a>
                <a class="nav-btn" href="/Orders">Мои заказы</a>
                <a class="nav-btn" href="/Settings">Настройки</a>
                <form method="post" asp-page="/Index" asp-page-handler="Logout" style="margin: 0;">
                    <button type="submit" class="nav-btn">Выйти</button>
                </form>
            }
        </div>
    </header>

    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
