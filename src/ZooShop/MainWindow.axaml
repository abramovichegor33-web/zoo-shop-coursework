<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZooShop.MainWindow"
        Title="Вход"
        Width="320" Height="320"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Магазин зоотоваров" FontSize="20" HorizontalAlignment="Center"/>
        <TextBox Name="LoginBox" Watermark="Логин"/>
        <TextBox Name="PasswordBox" Watermark="Пароль" PasswordChar="●"/>
        <Button Content="Войти" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Click="LoginButton_Click"/>
        <TextBlock Name="MessageText" TextWrapping="Wrap" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>