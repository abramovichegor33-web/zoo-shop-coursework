<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZooShop.ProductsWindow"
        Title="Магазин зоотоваров"
        Width="1150" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#2C2C2E"/>
        </Style>
        <Style Selector="TextBlock.price">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="#2C2C2E">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Магазин зоотоваров" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Name="UserText" Opacity="0.6" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Name="CartButton" Content="Корзина" Classes="flat" Click="CartButton_Click"/>
                    <Button Name="OrdersButton" Content="Мои заказы" Classes="flat" Click="OrdersButton_Click"/>
                    <Button Name="ColorButton" Content="Тема" Classes="flat"/>
                    <Button Content="Настройки" Classes="flat" Click="SettingsButton_Click"/>
                    <Button Content="Выйти" Classes="flat" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="24,16,24,8">
            <TextBox Name="SearchBox" Width="320" Watermark="Поиск по названию"/>
            <ComboBox Name="CategoryBox" Width="220"/>
            <Button Content="Сбросить" Classes="flat" Click="ResetButton_Click"/>
            <TextBlock Name="CartStatusText" VerticalAlignment="Center"/>
        </StackPanel>
        <TabControl Grid.Row="2" Margin="12,0,12,12">
            <TabItem Header="Каталог">
                <ScrollViewer>
                    <WrapPanel Name="CardsPanel" Margin="4"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Name="AdminTab" Header="Управление товарами" IsVisible="False">
                <Grid RowDefinitions="*,Auto" Margin="8">
                    <DataGrid Name="ProductsGrid" Grid.Row="0" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Name="AdminPanel" Grid.Row="1" Padding="16" Margin="0,12,0,0"
                            CornerRadius="16" BorderThickness="1" BorderBrush="#2C2C2E" Background="#1C1C1E">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Новый товар" FontWeight="SemiBold"/>
                            <WrapPanel>
                                <TextBox Name="NameBox" Width="220" Watermark="Название" Margin="0,0,8,8"/>
                                <ComboBox Name="AddCategoryBox" Width="180" Margin="0,0,8,8"/>
                                <TextBox Name="PriceBox" Width="100" Watermark="Цена" Margin="0,0,8,8"/>
                                <TextBox Name="QuantityBox" Width="90" Watermark="Кол-во" Margin="0,0,8,8"/>
                                <TextBox Name="DescriptionBox" Width="260" Watermark="Описание" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Добавить товар" Classes="accent" Click="AddButton_Click"/>
                                <Button Content="Удалить выбранный" Classes="flat" Click="DeleteButton_Click"/>
                                <TextBlock Name="StatusText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>