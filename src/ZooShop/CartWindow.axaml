<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZooShop.CartWindow"
        Title="Корзина"
        Width="720" Height="500" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Padding="16,12">
            <TextBlock Text="Корзина" FontSize="22" FontWeight="Bold" Foreground="White"/>
        </Border>
        <DataGrid Name="CartGrid" Grid.Row="1" Margin="12" IsReadOnly="True"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="12" Spacing="8">
            <TextBlock Name="TotalText" FontSize="18" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="+1" Click="PlusButton_Click"/>
                <Button Content="−1" Click="MinusButton_Click"/>
                <Button Content="Убрать из корзины" Click="RemoveButton_Click"/>
                <Button Content="Оформить заказ" Click="OrderButton_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="White"/>
            </StackPanel>
            <TextBlock Name="StatusText" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>